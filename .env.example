# Copy this to .env for local development. Never commit .env.

# --- Database ---
# Local: leave unset to use SQLite (database/titles.db)
# Production: set to your PostgreSQL connection string
DATABASE_URL=

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- CORS ---
# Comma-separated list of allowed origins.
# Local: leave unset (defaults to * for development)
# Production: set to your exact domain, e.g. https://clearoid.up.railway.app
ALLOWED_ORIGINS=

# --- ML Model Cache ---
# Where sentence-transformers caches the downloaded model.
# On Railway, set this to a path on a persistent volume (e.g. /data/model_cache)
# so the model isn't re-downloaded on every deploy.
SENTENCE_TRANSFORMERS_HOME=

# --- App ---
ENVIRONMENT=development
USE_OPENAI=false
IGNORE_NUMBERS=true

# --- Optional: OpenAI (only if USE_OPENAI=true) ---
OPENAI_API_KEY=
